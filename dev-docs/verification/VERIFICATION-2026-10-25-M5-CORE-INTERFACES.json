  "removed_spans": {
    "fvwm/focus.c": [
      "void _ForceDeleteFocus(void)\n{\n\tsftfwin_args_t sf_args;\n\n\tmemset(&sf_args, 0, sizeof(sf_args));\n\tsf_args.do_allow_force_broadcast = 1;\n\tsf_args.is_focus_by_flip_focus_cmd = 0;\n\tsf_args.do_forbid_warp = 0;\n        sf_args.client_entered = 0;\n\tsf_args.do_force = 1;\n\tsf_args.set_by = FOCUS_SET_FORCE;\n\tset_focus_to_fwin(Scr.NoFocusWin, NULL, &sf_args);\n\n\treturn;\n}\n\n",
      "/* same as above, but forces to regrab buttons on the window under the pointer\n * if necessary */\nvoid focus_grab_buttons_on_pointer_window(void)\n{\n\tWindow w;\n\tFvwmWindow *fw;\n\n\tFQueryPointer(\n\t\t    dpy, Scr.Root, &JunkRoot, &w, &JunkX, &JunkY, &JunkX,\n\t\t    &JunkY, &JunkMask);\n\tif (XFindContext(dpy, w, FvwmContext, (caddr_t *) &fw) == XCNOENT)\n\t{\n\t\t/* pointer is not over a window */\n\t\treturn;\n\t}\n\tfocus_grab_buttons(fw);\n\n\treturn;\n}\n\n"
    ],
    "fvwm/geometry.c": [
      "void get_shaded_client_window_pos(\n\tFvwmWindow *fw, rectangle *ret_g)\n{\n\trectangle big_g;\n\tsize_borders b;\n\n\tget_window_borders(fw, &b);\n\tbig_g = (IS_MAXIMIZED(fw)) ? fw->g.max : fw->g.normal;\n\tget_relative_geometry(fw, &big_g, &big_g);\n\tswitch (SHADED_DIR(fw))\n\t{\n\tcase DIR_S:\n\tcase DIR_SW:\n\tcase DIR_SE:\n\t\tret_g->y = 1 - big_g.height + b.total_size.height;\n\t\tbreak;\n\tdefault:\n\t\tret_g->y = 0;\n\t\tbreak;\n\t}\n\tswitch (SHADED_DIR(fw))\n\t{\n\tcase DIR_E:\n\tcase DIR_NE:\n\tcase DIR_SE:\n\t\tret_g->x = 1 - big_g.width + b.total_size.width;\n\t\tbreak;\n\tdefault:\n\t\tret_g->x = 0;\n\t\tbreak;\n\t}\n\n\treturn;\n}\n\n",
      "/* update the frame_g according to the window's g.normal or g.max and shaded\n * state */\nvoid update_relative_geometry(FvwmWindow *fw)\n{\n\tget_relative_geometry(fw,\n\t\t&fw->g.frame,\n\t\t(IS_MAXIMIZED(fw)) ? &fw->g.max : &fw->g.normal);\n\tif (IS_SHADED(fw))\n\t{\n\t\tget_shaded_geometry(\n\t\t\tfw, &fw->g.frame, &fw->g.frame);\n\t}\n\n\treturn;\n}\n\n"
    ],
    "fvwm/focus.h": [
      "#define SetFocusWindowClientEntered(a, b, c) _SetFocusWindow(a, b, c, True);\n",
      "#define ForceDeleteFocus() _ForceDeleteFocus();\n",
      "void _ForceDeleteFocus(void);\n",
      "void focus_grab_buttons_on_pointer_window(void);\n",
      "FvwmWindow *focus_get_transientfor_fwin(const FvwmWindow *fw);\n"
    ],
    "fvwm/geometry.h": [
      "int get_title_gravity(\n\tFvwmWindow *fw);\n",
      "void get_shaded_client_window_pos(\n\tFvwmWindow *fw, rectangle *ret_g);\n",
      "void update_relative_geometry(FvwmWindow *fw);\n"
    ]
  },
