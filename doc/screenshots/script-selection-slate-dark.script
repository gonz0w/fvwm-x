WindowTitle {OwnerProbe}
WindowSize 300 70
WindowPosition 60 60
Font "xft:DejaVu Sans:size=10"
ForeColor {#e5edf0}
BackColor {#202a31}
HilightColor {#536570}
ShadowColor {#122128}
Init
Begin
 Set $file={/tmp/fvwm-script-owner-4hbpy4wy/owner.report}
 WriteToFile $file {ready}
 Set $init=(ReceivFromScript 0)
 WriteToFile $file {init-message:} $init
End
PeriodicTasks
Begin
 WriteToFile $file {heartbeat}
End
QuitFunc
Begin
 WriteToFile $file {quitting}
End
Widget 1
Property
 Type TextField
 Position 10 10
 Size 260 26
 Title {owner-one}
Main
Case message of
10 :
Begin
 ChangeTitle 1 {widget-updated}
 WriteToFile $file {case-10}
End
11 :
Begin
 ChangeTitle 1 {owner-two}
 WriteToFile $file {case-11}
End
20 :
Begin
 SendToScript 0 {a1}
 SendToScript 1 {b1}
 SendToScript 0 {a2}
 SendToScript 1 {b2}
 SendToScript 0 {a3}
 WriteToFile $file {case-20}
End
21 :
Begin
 Set $large={}
 For $i=1 To 5 Do
 Begin
 SendToScript 0 $large
 End
 SendToScript 1 $large {x}
 SendToScript 1 {tail}
 WriteToFile $file {case-21}
End
22 :
Begin
 SendToScript 0 {retained}
 WriteToFile $file {case-22}
End
24 :
Begin
 SendToScript 0 {invalid-atom-first}
 SendToScript 0 {invalid-atom-second}
 WriteToFile $file {case-24}
End
23 :
Begin
 Quit
 WriteToFile $file {case-23}
End
30 :
Begin
 Set $reply=(ReceivFromScript 0)
 WriteToFile $file {message:} $reply
 WriteToFile $file {case-30}
End
31 :
Begin
 WriteToFile $file {text:} (GetTitle 1)
 WriteToFile $file {case-31}
End
32 :
Begin
 ChangeTitle 1 {}
 WriteToFile $file {case-32}
End
End
