option(
    'bidi',
    type: 'feature',
    value: 'auto',
    description: 'Enable fribidi support',
)
option(
    'freetype',
    type: 'feature',
    value: 'auto',
    description: 'Enable freetype support',
)
option(
    'docdir',
    type: 'string',
    description: 'Directory to install documentation',
)
option(
    'htmldoc',
    type: 'boolean',
    value: false,
    description: 'Enable generation of HTML man pages',
)
option(
    'iconv',
    type: 'feature',
    value: 'auto',
    description: 'Enable iconv support',
)
option(
    'live-x-tests',
    type: 'boolean',
    value: false,
    description: 'Build non-installed live-X integration test targets',
)
option(
    'mandoc',
    type: 'boolean',
    value: false,
    description: 'Enable generation of man pages',
)
option('nls', type: 'feature', value: 'auto', description: 'Enable NLS')
option('png', type: 'feature', value: 'auto', description: 'Enable png support')
option(
    'python',
    type: 'string',
    description: 'Select python implementation',
)
option(
    'session-dbus',
    type: 'feature',
    value: 'disabled',
    description: 'Enable optional session bus clients and the owned-bus guardian',
)
option(
    'settings-portal',
    type: 'boolean',
    value: false,
    description: 'Install the optional XSETTINGS-to-Settings portal backend',
)
option(
    'sm',
    type: 'feature',
    value: 'auto',
    description: 'Enable session management support',
)
option(
    'svg',
    type: 'feature',
    value: 'auto',
    description: 'Enable svg support',
)
option(
    'xcursor',
    type: 'feature',
    value: 'auto',
    description: 'Enable Xcursor support',
)
option(
    'xfixes',
    type: 'feature',
    value: 'auto',
    description: 'Enable XFixes support',
)
option(
    'xrender',
    type: 'feature',
    value: 'auto',
    description: 'Enable XRender support',
)
option(
    'xpm',
    type: 'feature',
    value: 'auto',
    description: 'Enable X PixMap (xpm) support',
)
option(
    'colorset-limit',
    type: 'integer',
    min: 1,
    max: 65536,
    value: 4096,
    description: 'Maximum distinct colorsets per core/module process, including default zero',
)

option(
    'png-security-backport', type: 'boolean', value: false,
    description: 'Assert that an older libpng has verified vendor security backports; not a vulnerability check',
)

option(
    'image-input-limit', type: 'integer', min: 1, max: 1024, value: 128,
    description: 'Maximum regular-file image source bytes in MiB',
)
option(
    'image-xpm-expanded-limit', type: 'integer', min: 1, max: 1024, value: 128,
    description: 'Maximum expanded compressed XPM bytes in MiB',
)
option(
    'image-decompress-timeout', type: 'integer', min: 1, max: 60, value: 5,
    description: 'Overall compressed XPM decompression deadline in seconds',
)
option(
    'image-gzip', type: 'string', value: '',
    description: 'Trusted gzip-compatible executable; empty resolves gzip at configure time',
)

option(
    'image-svg-timeout', type: 'integer', min: 1, max: 60, value: 5,
    description: 'Overall isolated SVG decoder deadline in seconds',
)
option(
    'image-svg-memory-limit', type: 'integer', min: 128, max: 4096, value: 1024,
    description: 'SVG worker address/data allocation limit in MiB',
)

option(
    'font-shadow-limit', type: 'integer', min: 1, max: 65536, value: 4096,
    description: 'Maximum shadow positions per text draw, excluding foreground',
)

option(
    'image-effect-timeout', type: 'integer', min: 1, max: 60, value: 5,
    description: 'Isolated software colorset effect deadline in seconds',
)
option(
    'image-effect-memory-limit', type: 'integer', min: 128, max: 4096,
    value: 1024,
    description: 'Software effect worker address/data allocation limit in MiB',
)

option(
    'pager-max-desks',
    type: 'integer',
    min: 1,
    max: 65536,
    value: 4096,
    description: 'Maximum displayed desks per Pager instance',
)
