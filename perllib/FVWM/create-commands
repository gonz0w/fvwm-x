# Checked generation requires an explicit candidate directory; normal builds
# use the committed, qualified metadata and need no generator.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 "$script_dir/../../tools/maintenance/generate.py" metadata "$@"
